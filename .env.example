# Copy to .env and fill in. .env is gitignored; never commit real values.
#
#   docker compose up                              local stack, uses the defaults below
#   docker compose -f docker-compose.prod.yml up   VPS stack, needs every value here

# ── Local development ─────────────────────────────────────────────────────────
# Optional locally: docker-compose.yml has working defaults for all of these.

# Any random string of at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# The OAuth client id from console.cloud.google.com. Leave blank and the
# Google button simply does not render, which is fine for local work.
GOOGLE_CLIENT_ID=

# ── Production (docker-compose.prod.yml) ──────────────────────────────────────

# Neon, in Npgsql form. Take the connection string from the Neon console and keep
# sslmode=require: Neon refuses plaintext connections.
#   Host=ep-xxx.eu-central-1.aws.neon.tech;Database=sprout;Username=sprout_owner;Password=...;SSL Mode=Require;Trust Server Certificate=true
SPROUT_CONNECTION_STRING=

# The same database as a JDBC URL, which is what Flyway speaks.
#   jdbc:postgresql://ep-xxx.eu-central-1.aws.neon.tech/sprout?sslmode=require
FLYWAY_JDBC_URL=
NEON_USER=
NEON_PASSWORD=

# Token settings. The issuer and audience only have to agree with themselves.
JWT_ISSUER=sprout
JWT_AUDIENCE=sprout-app

# Where the app is served from, used for the CORS allow-list.
PUBLIC_ORIGIN=https://sprout.example.com
