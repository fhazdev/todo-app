# Vite reads these at build time and bakes them into the bundle. Nothing secret
# belongs here: everything in this file ships to the browser.

# Where the API lives. Leave empty in production, where nginx serves the app and
# proxies /api on the same origin, so the client can use relative paths.
VITE_API_BASE_URL=http://localhost:5080

# The Google OAuth client id. Blank hides the Google button entirely.
VITE_GOOGLE_CLIENT_ID=
